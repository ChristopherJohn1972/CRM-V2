# Django settings
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace_with_a_secure_random_string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=crm-backend-production.up.railway.app

# PostgreSQL database (Railway auto-sets DATABASE_URL when linked to Aiven/PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/dbname?sslmode=require
# Alternative: individual settings (used when DATABASE_URL is not set)
# CRM_DB_HOST=127.0.0.1
# CRM_DB_PORT=5432
# CRM_DB_NAME=crm_v2
# CRM_DB_USER=your_database_user
# CRM_DB_PASSWORD=your_database_password

# JWT authentication
CRM_JWT_SECRET=replace_with_a_secure_random_string_at_least_64_chars
CRM_JWT_ACCESS_TTL_MINUTES=60
CRM_JWT_ALGORITHM=HS256

# CORS (frontend origin)
CRM_CORS_ORIGINS=https://crm-v2-mu.vercel.app

# Object storage. dev = local filesystem, s3 = boto3 bucket.
CRM_STORAGE_BACKEND=dev
CRM_STORAGE_ROOT=./storage

# OpenAI API key (for AI billboard/creative generation). Empty -> Pillow fallback only.
CRM_OPENAI_API_KEY=

# Email/SMTP configuration
CRM_EMAIL_HOST=smtp.gmail.com
CRM_EMAIL_PORT=587
CRM_EMAIL_USE_TLS=true
CRM_EMAIL_HOST_USER=your_email@gmail.com
CRM_EMAIL_HOST_PASSWORD=your_app_password
CRM_DEFAULT_FROM_EMAIL=CRM <noreply@yourdomain.com>

# Scout security alert email
CRM_SCOUT_SECURITY_EMAIL=your_email@example.com

# Account credentials (set via Railway env vars, not committed)
# CRM_ADMIN_PASSWORD=your_secure_password
# CRM_SCOUT_PASSWORD=your_secure_password
