DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace_with_a_secure_random_string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_NAME=crm_v2
CRM_DB_USER=your_database_user
CRM_DB_PASSWORD=your_database_password
# Alternatively provide a full URL (overrides the individual settings):
# CRM_DATABASE_URL=mysql+pymysql://user:password@host:port/dbname?charset=utf8mb4

CRM_JWT_SECRET=replace_with_a_secure_random_string_at_least_64_chars
CRM_JWT_ACCESS_TTL_MINUTES=60
CRM_JWT_ALGORITHM=HS256

# Object storage. dev = local filesystem under CRM_STORAGE_ROOT, s3 = boto3 bucket.
CRM_STORAGE_BACKEND=dev
CRM_STORAGE_ROOT=./storage
CRM_S3_BUCKET=
CRM_S3_REGION=
CRM_S3_PRESIGNED_URL_TTL=300

# Accounting integration (optional). Empty/absent disables the call -> 360 shows unavailable.
CRM_ACCOUNTING_BASE_URL=
CRM_ACCOUNTING_API_TOKEN=
CRM_ACCOUNTING_TIMEOUT_SECONDS=3

# SMS provider (optional). Empty -> logs SMS locally (dev mode).
CRM_SMS_PROVIDER_URL=
CRM_SMS_PROVIDER_TOKEN=
# Secret required in X-Webhook-Token header on provider webhooks.
CRM_WEBHOOK_SECRET=replace_with_a_secure_random_string

# OpenAI API key (for AI billboard/creative generation). Empty -> Pillow fallback only.
CRM_OPENAI_API_KEY=

# Scout security alert email
CRM_SCOUT_SECURITY_EMAIL=your_email@example.com
